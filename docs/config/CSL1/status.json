      {
        "code": "tr1", "name": "1#卷取机", "side": "coiler",
        "coil_no": { "name": "coil_info1_exit_coil_no", "type": "string" },
        "remaining_length": { "name": "tr_length", "type": "float" }
      }
    ]
  }
}
