{
  "enable": true,
  "mqtt_topic": "collector/zrm1_status_tracking",
  "tracking": {
    "point_prefix": "/aygg_tracking/zrm1/status/tracking/",
    "start_condition": {
      "point": {
        "name": "mill_speed_pv",
        "type": "short"
      },
      "threshold": 0
    },
    "sample_count": 4,
    "min_length_change": 0.01,
    "current_clear_threshold": 10,
    "monotonicity_check_enabled": false,
    "rolling": {
      "direct_point": {
        "name": "rolling_direction",
        "type": "bool"
      },
      "pass_no_point": {
        "name": "pass_no_pv",
        "type": "short"
      },
      "direct_reverse": false,
      "quality_output_enabled": true,
      "quality_min_speed": 10,
      "out_thickness_point": {
        "name": "exit_thickness_pv",
        "type": "float"
      }
    },
    "coiler_method_def": {
      "uncoiler": {
        "name": [
          "上开卷",
          "下开卷"
        ],
        "code": [
          "11",
          "91"
        ]
      },
      "coiler": {
        "name": [
          "上卷取",
          "下卷取"
        ],
        "code": [
          "19",
          "99"
        ]
      }
    },
    "points": [
      {
        "code": "por1",
        "name": "开卷机",
        "position": "right",
        "side": "uncoiler",
        "coil_no": {
          "name": "por_coil_no",
          "type": "string"
        },
        "remaining_length": {
          "name": "por_coil_length",
          "type": "float"
        },
        "coiler_method": {
          "default": false,
          "false_index": 0
        }
      },
      {
        "code": "tr1",
        "name": "入口-右边卷取机",
        "position": "right",
        "side": "coiler",
        "coil_no": {
          "name": "entry_tr_coil_no",
          "type": "string"
        },
        "remaining_length": {
          "name": "entry_right_tr_coil_length",
          "type": "float"
        },
        "coiler_method": {
          "default": true,
          "false_index": 0
        }
      },
      {
        "code": "tr2",
        "name": "出口-左边卷取机",
        "position": "left",
        "side": "coiler",
        "coil_no": {
          "name": "exit_tr_coil_no",
          "type": "string"
        },
        "remaining_length": {
          "name": "exit_left_tr_coil_length",
          "type": "float"
        },
        "coiler_method": {
          "default": true,
          "false_index": 0
        }
      }
    ]
  }
}
