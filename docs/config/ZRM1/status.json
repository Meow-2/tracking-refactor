{
  "enable": true,
  "mqtt_topic": "zrm1_status_tracking",
  "tracking": {
    "point_prefix": "/aygg_tracking/zrm1/status/tracking/",
    "start_condition": { "point": { "name": "mill_speed_pv", "type": "short" }, "threshold": 0 },
    "sample_count": 4,
    "min_length_change": 0.5,
    "monotonicity_check_enabled": false,
    "points": [
      {
        "code": "por1", "name": "入口卷取机", "side": "uncoiler",
        "coil_no": { "name": "entry_tr_coil_no", "type": "string" },
        "remaining_length": { "name": "entry_right_tr_coil_length", "type": "float" }
      },
      {
        "code": "tr1", "name": "出口卷取机", "side": "coiler",
        "coil_no": { "name": "exit_tr_coil_no", "type": "string" },
        "remaining_length": { "name": "exit_left_tr_coil_length", "type": "float" }
      }
    ]
  }
}
