{
  "enable": true,
  "mqtt_topic": "collector/zrm1_process_tracking",
  "tracking": {
    "point_prefix": "/aygg_tracking/zrm1/process/tracking/",
    "speed_point": {
      "name": "mill_speed_pv",
      "type": "float"
    },
    "start_condition": {
      "point": {
        "name": "mill_speed_pv",
        "type": "float"
      },
      "threshold": 10
    },
    "length_mode": "rolling",
    "rolling": {
      "direct_point": {
        "name": "rolling_direction",
        "type": "bool"
      },
      "pass_no_point": {
        "name": "pass_no_pv",
        "type": "short"
      },
      "direct_reverse": false
    },
    "points": [
      {
        "length": {
          "name": "entry_right_tr_coil_length",
          "type": "float"
        },
        "coil_no": {
          "name": "entry_tr_coil_no",
          "type": "string"
        },
        "is_rolling_coiler": true
      },
      {
        "length": {
          "name": "exit_left_tr_coil_length",
          "type": "float"
        },
        "coil_no": {
          "name": "exit_tr_coil_no",
          "type": "string"
        },
        "is_rolling_coiler": false
      }
    ]
  },
  "segments": [
    {
      "code": "default",
      "name": "默认段",
      "point_prefix": "/aygg_tracking/zrm1/process/tech/default/",
      "length_correct": 0,
      "points": [
        {
          "name": "entry_thickness_diff_pv",
          "type": "float"
        },
        {
          "name": "exit_thickness_diff_pv",
          "type": "float"
        },
        {
          "name": "entry_thickness_pv",
          "type": "float"
        },
        {
          "name": "exit_thickness_pv",
          "type": "float"
        },
        {
          "name": "entry_thickness_sv",
          "type": "float"
        },
        {
          "name": "exit_thickness_sv",
          "type": "float"
        },
        {
          "name": "entry_right_tr_tension_pv",
          "type": "float"
        },
        {
          "name": "exit_left_tr_tension_pv",
          "type": "float"
        }
      ]
    }
  ]
}
